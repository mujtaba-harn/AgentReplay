{
  "name": "crafter-replay",
  "version": "0.1.0",
  "description": "Replay a Claude Code session in your browser. Data never leaves your computer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mujtaba-harn/AgentReplay.git"
  },
  "homepage": "https://github.com/mujtaba-harn/AgentReplay#readme",
  "bugs": "https://github.com/mujtaba-harn/AgentReplay/issues",
  "keywords": [
    "claude-code",
    "replay",
    "timeline",
    "ai-agent",
    "cli"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "crafter-replay": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke-packed.ts",
    "prepack": "node scripts/copy-docs.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "open": "^11.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@agentreplay/core": "workspace:*",
    "@agentreplay/web": "workspace:*",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
