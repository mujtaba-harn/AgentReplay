{
  "name": "@agentreplay/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@agentreplay/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./format": {
      "@agentreplay/source": "./src/format.ts",
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \"test/perf/**\" && vitest run test/perf",
    "fixtures:public": "node test/support/make-public-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
