{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // Type-check against core's source so `pnpm check` works before core is built.
    "customConditions": ["@crafter-replay/source"],
    "noEmit": true
  },
  "include": ["src", "test", "vite.config.ts"]
}
